; Engine configuration file.
; Godot 4.5+. Eldwood: a rustic 8-bit survival side-scroller in a medieval forest.
; Android, portrait (held upright), touch controls, 2D physics at a fixed 60 Hz.

config_version=5

[application]

config/name="Eldwood"
config/description="A rustic 8-bit survival side-scroller: make your character, build up your forest cabin, uncover the old forest's story."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Mobile")
config/icon="res://icon.svg"

[display]

; 8-bit look: the whole game renders at 180×320 real pixels (portrait), scaled up by a WHOLE
; number (×4 on a 720-wide phone, ×6 on 1080, ×8 on 1440) so every pixel stays a crisp square.
; Taller phones see a few more rows (aspect = expand).
window/size/viewport_width=180
window/size/viewport_height=320
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/handheld/orientation=1
window/energy_saving/keep_screen_on=true

[input_devices]

; Desktop testing: the mouse also acts as a touch (on-screen buttons work with a mouse).
pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[input]

move_left={
"deadzone": 0.2,
